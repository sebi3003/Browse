<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- English-only, win-x64-only app: skip satellite resource folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>Browse</AssemblyTitle>
    <Product>Browse</Product>
    <Version>1.0.9</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <!-- Velopack requires taking over Main() (see App.xaml.cs), so App.xaml is no longer the entry point. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
</Project>
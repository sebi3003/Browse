<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Icons taken unchanged from the Capture app (Capture\Views\CaptureIcons.xaml), so both apps share one look.
         48x48 vector DrawingImages: set Width/Height on the consuming <Image>. -->

    <DrawingImage x:Key="CutIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L48,0 L48,48 L0,48 Z"/>
                <GeometryDrawing Geometry="M14,4 L31,32 M34,4 L17,32">
                    <GeometryDrawing.Pen><Pen Brush="#CFD8DC" Thickness="4.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#EF5350" Thickness="4"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="14,38" RadiusX="6" RadiusY="6"/>
                            <EllipseGeometry Center="34,38" RadiusX="6" RadiusY="6"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="CopyIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L48,0 L48,48 L0,48 Z"/>
                <GeometryDrawing Brush="#90CAF9"><GeometryDrawing.Geometry><RectangleGeometry Rect="5,4,26,30" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#42A5F5" Offset="0"/>
                            <GradientStop Color="#1565C0" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="17,14,26,30" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M23,24 L37,24 M23,31 L37,31 M23,38 L32,38">
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="PasteIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L48,0 L48,48 L0,48 Z"/>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFB74D" Offset="0"/>
                            <GradientStop Color="#EF6C00" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="7,8,34,37" RadiusX="6" RadiusY="6"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#78909C"><GeometryDrawing.Geometry><RectangleGeometry Rect="16,3,16,10" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="13,19,22,21" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Geometry="M18,26 L30,26 M18,32 L26,32">
                    <GeometryDrawing.Pen><Pen Brush="#90A4AE" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="DeleteIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L48,0 L48,48 L0,48 Z"/>
                <GeometryDrawing Brush="#FF8A80"><GeometryDrawing.Geometry><RectangleGeometry Rect="17,3,14,8" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Geometry="M10,17 L38,17 L36,42 A4,4 0 0 1 32,45 L16,45 A4,4 0 0 1 12,42 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF8A80" Offset="0"/>
                            <GradientStop Color="#D32F2F" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="#EF5350"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,9,36,7" RadiusX="3.5" RadiusY="3.5"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Geometry="M19,24 L19,38 M24,24 L24,38 M29,24 L29,38">
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Browse's own, drawn in the same 48x48 DrawingImage style: the folder icon on the bookmarks bar and in folder panels. -->
    <DrawingImage x:Key="FolderIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L48,0 L48,48 L0,48 Z"/>
                <GeometryDrawing Brush="#F9A825" Geometry="M3,12 A4,4 0 0 1 7,8 L18,8 L23,13 L41,13 A4,4 0 0 1 45,17 L45,38 A4,4 0 0 1 41,42 L7,42 A4,4 0 0 1 3,38 Z"/>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFE082" Offset="0"/>
                            <GradientStop Color="#FFC107" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="3,19,42,23" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- A YouTube-style mark (red rounded screen, white play triangle) for "Add channel to folder". -->
    <DrawingImage x:Key="YouTubeIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L48,0 L48,48 L0,48 Z"/>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF4E45" Offset="0"/>
                            <GradientStop Color="#E00000" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="2,9,44,30" RadiusX="10" RadiusY="10"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="White" Geometry="M19.5,16.5 L19.5,31.5 L32.5,24 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Stand-in for a bookmark whose site icon has not been fetched yet. -->
    <DrawingImage x:Key="GlobeIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L48,0 L48,48 L0,48 Z"/>
                <GeometryDrawing Geometry="M24,5 A19,19 0 1 1 23.99,5 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7BBBE0" Thickness="3"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M5,24 L43,24 M24,5 C16,14 16,34 24,43 M24,5 C32,14 32,34 24,43">
                    <GeometryDrawing.Pen><Pen Brush="#7BBBE0" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>

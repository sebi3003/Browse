<UserControl x:Class="Browse.Views.FeedsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Feeds page: folders | channels | videos | the YouTube page. Same panel look as the rest of Browse (32 px panels, 4 px corners,
         6 px gaps); channels and videos get panels twice as high, each with its own thumbnail panel next to the label panel. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Slate" Color="#1A2332"/>
        <SolidColorBrush x:Key="SlateHover" Color="#232F42"/>
        <SolidColorBrush x:Key="Selected" Color="#2B4F94"/>
        <SolidColorBrush x:Key="Navy" Color="#0B2A5B"/>
        <SolidColorBrush x:Key="NavyHover" Color="#123A7A"/>
        <SolidColorBrush x:Key="Light" Color="#E7EDF5"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA0A6"/>

        <!-- Folder: label panel only, dark blue like the bookmark folders. -->
        <Style x:Key="FolderItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="L" CornerRadius="4" Background="{StaticResource Navy}" Padding="10,0">
                            <Grid>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontFamily="Segoe UI" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,34,0"/>
                                <TextBlock Text="{Binding CountText}" Foreground="#9FB4D9" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="L" Property="Background" Value="{StaticResource NavyHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="L" Property="Background" Value="{StaticResource Selected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Channel: 64 px, its icon in a square thumbnail panel, then the label panel. -->
        <Style x:Key="ChannelItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Opacity="{Binding Dim}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="64" CornerRadius="4" Margin="0,0,3,0" Background="{StaticResource Slate}">
                                <Grid>
                                    <Border CornerRadius="4"><Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Border.Background></Border>
                                    <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" Foreground="{StaticResource Light}" FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border x:Name="L" Grid.Column="1" CornerRadius="4" Background="{StaticResource Slate}" Padding="12,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Light}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="L" Property="Background" Value="{StaticResource SlateHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="L" Property="Background" Value="{StaticResource Selected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Video: 64 px, the video thumbnail (16:9) in its own panel, then the label panel with title, channel and age. -->
        <Style x:Key="VideoItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="114" CornerRadius="4" Margin="0,0,3,0" Background="{StaticResource Slate}">
                                <Border CornerRadius="4"><Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Border.Background></Border>
                            </Border>
                            <Border x:Name="L" Grid.Column="1" CornerRadius="4" Background="{StaticResource Slate}" Padding="12,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Light}" FontFamily="Segoe UI" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="L" Property="Background" Value="{StaticResource SlateHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="L" Property="Background" Value="{StaticResource Selected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The "+" tile next to the Folders header: create a new folder. -->
        <Style x:Key="NewFolderButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="4" Background="{StaticResource Navy}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource NavyHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter chips above the videos. -->
        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#1A2332"/>
            <Setter Property="Foreground" Value="#E7EDF5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Columns" Margin="6,6,6,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/><ColumnDefinition Width="6"/>
            <ColumnDefinition Width="300"/><ColumnDefinition Width="6"/>
            <ColumnDefinition Width="470"/><ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1: folders -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Height="32" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border CornerRadius="4" Background="{StaticResource Navy}" Padding="10,0" Margin="0,0,3,0">
                    <TextBlock Text="Folders" Foreground="White" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <Button Grid.Column="1" AutomationProperties.AutomationId="NewFolderButton" Style="{StaticResource NewFolderButton}" Content="&#xE710;" ToolTip="New folder" Click="NewFolder_Click"/>
            </Grid>
            <ListBox x:Name="FolderList" Grid.Row="1" Style="{StaticResource ColumnList}" ItemContainerStyle="{StaticResource FolderItem}"
                     SelectionChanged="FolderList_SelectionChanged"/>
        </Grid>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- 2: channels -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Height="32" Margin="0,0,0,6" CornerRadius="4" Background="{StaticResource Slate}" Padding="10,0">
                <TextBlock Text="Channels" Foreground="{StaticResource Light}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
            <ListBox x:Name="ChannelList" Grid.Row="1" Style="{StaticResource ColumnList}" ItemContainerStyle="{StaticResource ChannelItem}"
                     SelectionChanged="ChannelList_SelectionChanged" PreviewMouseLeftButtonUp="ChannelList_PreviewMouseUp"/>
        </Grid>
        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- 3: videos (the feed) -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="TodayChip" Style="{StaticResource FilterChip}" Content="Today" Tag="today" Click="Filter_Click"/>
                <Button x:Name="WeekChip" Style="{StaticResource FilterChip}" Content="Week" Tag="week" Click="Filter_Click"/>
                <Button x:Name="Last5Chip" Style="{StaticResource FilterChip}" Content="Last 5" Tag="last5" Click="Filter_Click"/>
                <Button x:Name="AllChip" Style="{StaticResource FilterChip}" Content="All" Tag="all" Click="Filter_Click"/>
                <Button Style="{StaticResource FilterChip}" Content="Refresh" Click="Refresh_Click"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <ListBox x:Name="VideoList" Grid.Row="1" Style="{StaticResource ColumnList}" ItemContainerStyle="{StaticResource VideoItem}"
                     SelectionChanged="VideoList_SelectionChanged"/>
        </Grid>
        <GridSplitter Grid.Column="5" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- 4: the video itself (a YouTube watch page) -->
        <Grid Grid.Column="6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="PlayerHeader" Height="32" Margin="0,0,0,6" CornerRadius="4" Background="{StaticResource Slate}" Padding="10,0">
                <TextBlock x:Name="NowPlaying" Text="Pick a video" Foreground="{StaticResource Light}" FontFamily="Segoe UI" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="PlayerHost" Grid.Row="1" CornerRadius="4" Background="#0A0C10"/>
        </Grid>
    </Grid>
</UserControl>

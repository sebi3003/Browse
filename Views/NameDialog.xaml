<Window x:Class="Browse.Views.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse" Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#0A0C10" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14">
    <!-- A small dark "type a name" box, in the same panel look as the rest of Browse. -->
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="#E7EDF5"/>
            <Setter Property="Background" Value="#1A2332"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="4" Background="{TemplateBinding Background}" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock x:Name="Prompt" Foreground="#E7EDF5" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <Border CornerRadius="4" Background="#1A2332" BorderBrush="#2B4F94" BorderThickness="1" Height="34">
            <TextBox x:Name="NameBox" Background="Transparent" Foreground="#E7EDF5" CaretBrush="#E7EDF5" SelectionBrush="#5C8AF2"
                     BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" MaxLength="60"
                     TextChanged="NameBox_TextChanged" KeyDown="NameBox_KeyDown"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Style="{StaticResource DialogButton}" Background="#2B4F94" Foreground="White" Content="OK" IsDefault="True" IsEnabled="False" Click="Ok_Click"/>
            <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="Browse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Browse.Services"
        xmlns:views="clr-namespace:Browse.Views"
        Title="Browse" Width="1280" Height="800" WindowState="Maximized" Background="{StaticResource Bg}"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <svc:BookmarkIconConverter x:Key="BookmarkIcon"/>

        <!-- Bookmark chip, same shape as the shortcut chips in File Manager (ShortcutChipBtn). Link bookmarks use the colours of an
             unselected tab (dark slate, light text); folders are File Manager's dark blue (TrashChipBtn) with white text; each gets a
             lighter hover. -->
        <Style x:Key="BookmarkChip" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#1A2332"/>
            <Setter Property="Foreground" Value="#E7EDF5"/>
            <Setter Property="BorderBrush" Value="#1A2332"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Two separate panels side by side: the icon tile (Button.Tag is the bookmark: yellow folder, or the page's
                         icon in a dark blue frame) and the label panel, which carries the chip colours. -->
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="IconPanel" Width="32" CornerRadius="4" Margin="0,0,3,0" Background="#1A2332">
                                <Image Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BookmarkIcon}}"/>
                            </Border>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <!-- Folders have no icon tile, just the label panel. -->
                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                <Setter TargetName="IconPanel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#232F42"/>
                    <Setter Property="BorderBrush" Value="#232F42"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter Property="Background" Value="#0B2A5B"/>
                    <Setter Property="BorderBrush" Value="#08204A"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFolder}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#123A7A"/>
                    <Setter Property="BorderBrush" Value="#0B2A5B"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Cancel / dismiss buttons of the download strip (File Manager's OpBtn). -->
        <Style x:Key="OpBtn" TargetType="Button">
            <Setter Property="Background" Value="#18212B"/>
            <Setter Property="Foreground" Value="#E7EDF5"/>
            <Setter Property="BorderBrush" Value="#3A4656"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Back / forward: the same rounded tile as the icon tiles on the bookmarks and the address bar. -->
        <Style x:Key="ToolChip" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#0B2A5B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" CornerRadius="4" Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Hover / pressed lighten whatever colour the button has, by laying a faint white sheet over it. -->
                                <Border x:Name="Glow" CornerRadius="4" Background="White" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="0.16"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="0.3"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Downloads (orange) and menu (green) tiles, in File Manager's orange (NetworkChipBtn) and green (DriveChipBtn) chip colours. -->
        <Style x:Key="ToolChipOrange" TargetType="Button" BasedOn="{StaticResource ToolChip}">
            <Setter Property="Background" Value="#E0E07B16"/>
        </Style>
        <Style x:Key="ToolChipGreen" TargetType="Button" BasedOn="{StaticResource ToolChip}">
            <Setter Property="Background" Value="#802E9E4F"/>
        </Style>

        <!-- Work / Private switch at the left end of the bookmarks bar: same two-panel chip shape as the bookmarks.
             Set from code (ApplyProfile): Background = label panel, BorderBrush = darker icon panel, Tag = icon glyph. -->
        <Style x:Key="ProfileChip" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel x:Name="Root" Orientation="Horizontal">
                            <Border Width="32" CornerRadius="4" Margin="0,0,3,0" Background="{TemplateBinding BorderBrush}">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.85"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab: the same two-panel chip as the bookmarks (32 px; the page's icon in a dark blue tile, then the label panel with the
             title and the close button). The selected tab's label panel is bright blue; middle-click or x closes. -->
        <Style x:Key="TabItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Orientation="Horizontal" Height="32">
                            <Border Width="32" CornerRadius="4" Margin="0,0,3,0" Background="#0B2A5B">
                                <Image Source="{Binding Icon, TargetNullValue={StaticResource GlobeIcon}}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Border x:Name="B" Width="158" CornerRadius="4" Background="#1A2332" Padding="10,0,5,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="T" Text="{Binding Title}" Foreground="#E7EDF5" FontFamily="Segoe UI" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="✕" FontSize="10" Width="22" Height="22" Click="CloseTab_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#232F42"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2B4F94"/>
                                <Setter TargetName="T" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <StackPanel x:Name="TabRow" Grid.Row="2" Orientation="Horizontal" Margin="6,6,0,6">
            <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0" Padding="0" AllowDrop="True" ItemContainerStyle="{StaticResource TabItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     MaxWidth="{Binding ActualWidth, ElementName=TabRow}"
                     SelectionChanged="TabStrip_SelectionChanged" PreviewMouseMove="TabStrip_PreviewMouseMove" Drop="TabStrip_Drop" MouseRightButtonUp="TabStrip_RightClick"
                     PreviewMouseDown="TabStrip_PreviewMouseDown">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <Button Style="{StaticResource ToolChip}" Content="&#xE710;" Click="NewTab_Click" Margin="0" ToolTip="New tab (Ctrl+T)"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="0" Background="{StaticResource Surface}" Height="32" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="6,0">
                <!-- Work / Private toggle: very left, before back/forward, in the same two-panel chip shape as the bookmarks. One click flips it. -->
                <Button x:Name="ProfileButton" AutomationProperties.AutomationId="ProfileToggle" Style="{StaticResource ProfileChip}" Margin="0,0,6,0" Click="Profile_Click"/>
                <!-- Feeds: the YouTube feeds page; the same two-panel chip, YouTube red while the page is open. -->
                <Button x:Name="FeedsButton" AutomationProperties.AutomationId="FeedsToggle" Style="{StaticResource ProfileChip}" Margin="0,0,6,0"
                        Background="#1A2332" BorderBrush="#0B2A5B" Foreground="#E7EDF5" Tag="&#xE714;" Content="Feeds" Click="Feeds_Click"
                        ToolTip="Feeds: folders, channels, videos"/>
                <Button x:Name="BackButton" Style="{StaticResource ToolChip}" Content="&#xE72B;" Click="Back_Click" ToolTip="Back (Alt+Left)"/>
                <Button x:Name="ForwardButton" Style="{StaticResource ToolChip}" Content="&#xE72A;" Click="Forward_Click" ToolTip="Forward (Alt+Right)"/>
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Same two-panel shape as the bookmarks: the current page's icon in its own dark blue tile, then the text panel. -->
                <Border Width="32" Height="32" CornerRadius="4" Margin="0,0,3,0" Background="#0B2A5B">
                    <Image x:Name="AddressIcon" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="AddressPanel" Grid.Column="1" CornerRadius="4" Background="{StaticResource Bg}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource Hover}"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#5C8AF2"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBox x:Name="AddressBox" Height="30" FontSize="14" Padding="10,0,34,0" VerticalContentAlignment="Center"
                                 Background="Transparent" Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}"
                                 BorderThickness="0" SelectionBrush="#5C8AF2"
                                 GotKeyboardFocus="AddressBox_GotFocus" PreviewKeyDown="AddressBox_PreviewKeyDown" TextChanged="AddressBox_TextChanged"
                                 LostKeyboardFocus="AddressBox_LostFocus"/>
                        <Button x:Name="StarButton" Content="☆" HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,2,0" Click="Star_Click" ToolTip="Bookmark (Ctrl+D)"/>
                    </Grid>
                </Border>
                <Popup x:Name="Suggestions" Grid.Column="1" PlacementTarget="{Binding ElementName=AddressPanel}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" Focusable="False">
                    <ListBox x:Name="SuggestionList" Width="{Binding ActualWidth, ElementName=AddressPanel}" MaxHeight="360" Margin="0,2,0,0"
                             Background="{StaticResource Surface}" BorderBrush="{StaticResource Hover}" Foreground="{StaticResource Fg}" Focusable="False"
                             PreviewMouseLeftButtonUp="Suggestion_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Popup>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                <!-- Cache chip: icon tile + live cache size (the panel grows and shrinks with its text). One click clears the cache, no questions; page icons are kept. -->
                <Button x:Name="CacheButton" Style="{StaticResource ProfileChip}" Margin="0,0,6,0" Background="#1A2332" BorderBrush="#0B2A5B" Foreground="#E7EDF5"
                        Tag="&#xE74D;" Content="…" Click="ClearCache_Click" ToolTip="Cache - click to clear it (page icons are kept)"/>
                <!-- Same rounded tile as back / forward. -->
                <Button x:Name="UpdateButton" Style="{StaticResource ToolChip}" Content="&#xE898;" Visibility="Collapsed" Click="Update_Click" Foreground="#81C995" ToolTip="Update downloaded - click to restart"/>
                <Button Style="{StaticResource ToolChipOrange}" Content="&#xE896;" Click="Downloads_Click" ToolTip="Downloads (Ctrl+J)"/>
                <Button x:Name="MenuButton" AutomationProperties.AutomationId="MenuButton" Style="{StaticResource ToolChipGreen}" Content="&#xE712;" Margin="0" Click="Menu_Click" ToolTip="Menu">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MainMenu">
                            <MenuItem Header="History" InputGestureText="Ctrl+H" Click="History_Click"/>
                            <MenuItem Header="Developer tools" InputGestureText="F12" Click="DevTools_Click"/>
                            <MenuItem x:Name="ImportItem" Header="Import bookmarks from Edge" SubmenuOpened="Import_SubmenuOpened">
                                <MenuItem Header="…" IsEnabled="False"/>
                            </MenuItem>
                            <MenuItem x:Name="SyncItem" Header="Bookmark sync" SubmenuOpened="Sync_SubmenuOpened">
                                <MenuItem Header="…" IsEnabled="False"/>
                            </MenuItem>
                            <MenuItem Header="Fetch bookmark icons" Click="FetchIcons_Click"/>
                            <MenuItem Header="Add new feed channels from SebiTool" Click="ImportFeedChannels_Click"/>
                            <MenuItem Header="Import feed channels from an OPML file…" Click="ImportOpml_Click"/>
                            <MenuItem Header="Clear browsing data" Click="ClearData_Click"/>
                            <Separator/>
                            <MenuItem x:Name="VersionItem" IsEnabled="False"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Bookmarks bar under the toolbar: the chips wrap onto further rows when they don't fit (up to four rows, then it scrolls). -->
        <Grid x:Name="BookmarkRow" Grid.Row="1" Background="{StaticResource Surface}" MinHeight="32" Margin="0,6,0,0" MouseRightButtonUp="BookmarkRow_RightClick"
              AllowDrop="True" DragOver="BookmarkRow_DragOver" DragLeave="BookmarkRow_DragLeave" Drop="BookmarkRow_Drop">
            <TextBlock x:Name="BookmarkHint" Text="Press ☆ to add bookmarks to this profile" Foreground="{StaticResource Muted}" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,2" IsHitTestVisible="False"/>
            <ScrollViewer x:Name="BookmarkScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="152">
                <!-- The bottom margin cancels the 6 px each chip keeps below it, so the gap to the tab row is the same 6 px as everywhere else. -->
                <ItemsControl x:Name="BookmarkBar" Margin="6,0,0,-6" VerticalAlignment="Top"
                              PreviewMouseLeftButtonDown="BookmarkBar_PreviewMouseDown" PreviewMouseMove="BookmarkBar_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="BookmarkBar_PreviewMouseUp">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BookmarkChip}" Tag="{Binding}" ToolTip="{Binding Url}"
                                    Click="Bookmark_Click" MouseRightButtonUp="Bookmark_RightClick" MouseEnter="Bookmark_MouseEnter" MouseLeave="Bookmark_MouseLeave">
                                <TextBlock Text="{Binding Title}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- Where a dragged bookmark will land: a thin line between chips, or an outline around a folder to drop into. -->
            <Border x:Name="DropMarker" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" CornerRadius="3"/>
            <TextBlock x:Name="CutHint" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0" Padding="10,3"
                       Background="{StaticResource Hover}" Foreground="{StaticResource Fg}" FontSize="12" MaxWidth="360" TextTrimming="CharacterEllipsis"
                       ToolTip="Right-click a folder, or an empty spot on the bar, to paste. Click here to cancel."
                       MouseLeftButtonUp="CutHint_Click"/>
        </Grid>

        <!-- Icon bar shown by right-clicking a bookmark. -->
        <Popup x:Name="BookmarkActions" StaysOpen="False" AllowsTransparency="True" Placement="Mouse" HorizontalOffset="6" VerticalOffset="6">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Hover}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <!-- Icons come from the Capture app (see Icons.xaml); "open in new tab" has no Capture counterpart. -->
                    <Button x:Name="BookmarkDeleteButton" Click="BookmarkDelete_Click" ToolTip="Delete bookmark">
                        <Image Source="{StaticResource DeleteIcon}" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="BookmarkCutButton" Click="BookmarkCut_Click" ToolTip="Cut">
                        <Image Source="{StaticResource CutIcon}" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="BookmarkPasteButton" Click="BookmarkPaste_Click" ToolTip="Paste here">
                        <Image Source="{StaticResource PasteIcon}" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="BookmarkOpenButton" Content="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                            Click="BookmarkOpen_Click" ToolTip="Open in new tab"/>
                    <Button x:Name="BookmarkCopyButton" Click="BookmarkCopy_Click" ToolTip="Copy link">
                        <Image Source="{StaticResource CopyIcon}" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- One WebView2 per tab; only the selected one is visible. -->
        <Grid x:Name="Host" Grid.Row="3"/>
        <views:FeedsView x:Name="FeedsPanel" Grid.Row="3" Visibility="Collapsed"/>

        <!-- Download progress strip, same look as the copy progress in File Manager: a card per download with a progress bar,
             file name, percent (green), size (blue) and time left (yellow), Cancel and dismiss. The margin collapses when empty. -->
        <ItemsControl x:Name="DownloadStrip" Grid.Row="4">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Margin" Value="6,6,6,2"/>
                    <Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Margin" Value="0"/></Trigger></Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#11161C" BorderBrush="#202833" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                        <Border.Triggers>
                            <!-- Slide up from below the window edge on appearing. -->
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="90" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <!-- Slide back down on removal. -->
                                    <DataTrigger Binding="{Binding IsClosing}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="90" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <ProgressBar Height="44" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                             Background="#161D26" Foreground="#2B4F94" BorderThickness="0"/>
                                <Grid VerticalAlignment="Center" Margin="10,0,10,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Fixed widths + right alignment so changing digits don't shift the neighbours. -->
                                        <TextBlock Text="{Binding PercentText, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="#4ADE80" Width="90" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding SizeText, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="#5CC8FF" Margin="18,0,0,0" Width="210" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding SpeedText, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="#FFB454" Margin="18,0,0,0" Width="120" TextAlignment="Right"
                                                   ToolTip="Download speed"/>
                                        <TextBlock Text="{Binding EtaText, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="#F2E08C" Margin="18,0,0,0" Width="100" TextAlignment="Right"
                                                   ToolTip="Estimated time remaining"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource OpBtn}" IsEnabled="{Binding IsRunning}" Click="DownloadCancel_Click" VerticalAlignment="Top"/>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource OpBtn}" IsEnabled="{Binding IsDone}" Click="DownloadDismiss_Click" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>

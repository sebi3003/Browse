<Window x:Class="Browse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse" Width="1280" Height="800" WindowState="Maximized" Background="{StaticResource Bg}"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <!-- Chrome-style tab: rounded top, highlighted when selected, middle-click / x to close. -->
        <Style x:Key="TabItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" CornerRadius="8,8,0,0" Background="Transparent" Padding="10,0,4,0" Height="34">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="✕" FontSize="10" Width="22" Height="22" Click="CloseTab_Click"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource Surface}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <StackPanel x:Name="TabRow" Orientation="Horizontal" Margin="6,6,0,0">
            <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0" AllowDrop="True" ItemContainerStyle="{StaticResource TabItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     MaxWidth="{Binding ActualWidth, ElementName=TabRow}"
                     SelectionChanged="TabStrip_SelectionChanged" PreviewMouseMove="TabStrip_PreviewMouseMove" Drop="TabStrip_Drop"
                     PreviewMouseDown="TabStrip_PreviewMouseDown">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <Button Content="＋" Click="NewTab_Click" Margin="2,1,0,0" ToolTip="New tab (Ctrl+T)"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="1" Background="{StaticResource Surface}" Height="42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="6,0">
                <Button x:Name="BackButton" Content="←" Click="Back_Click" ToolTip="Back"/>
                <Button x:Name="ForwardButton" Content="→" Click="Forward_Click" ToolTip="Forward"/>
                <Button x:Name="ReloadButton" Content="⟳" Click="Reload_Click" ToolTip="Reload (Ctrl+R)"/>
                <Button Content="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Click="Home_Click" ToolTip="Home"/>
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                <TextBox x:Name="AddressBox" Height="30" FontSize="14" Padding="14,0,34,0" VerticalContentAlignment="Center"
                         Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}"
                         BorderThickness="0" SelectionBrush="#5C8AF2"
                         GotKeyboardFocus="AddressBox_GotFocus" PreviewKeyDown="AddressBox_PreviewKeyDown" TextChanged="AddressBox_TextChanged"
                         LostKeyboardFocus="AddressBox_LostFocus"/>
                <Button x:Name="StarButton" Content="☆" HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,2,0" Click="Star_Click" ToolTip="Bookmark (Ctrl+D)"/>
                <Popup x:Name="Suggestions" PlacementTarget="{Binding ElementName=AddressBox}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" Focusable="False">
                    <ListBox x:Name="SuggestionList" Width="{Binding ActualWidth, ElementName=AddressBox}" MaxHeight="360" Margin="0,2,0,0"
                             Background="{StaticResource Surface}" BorderBrush="{StaticResource Hover}" Foreground="{StaticResource Fg}" Focusable="False"
                             PreviewMouseLeftButtonUp="Suggestion_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Popup>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                <Button x:Name="UpdateButton" Content="⬆" Visibility="Collapsed" Click="Update_Click" Foreground="#81C995" ToolTip="Update downloaded - click to restart"/>
                <Button x:Name="ProfileButton" Width="Auto" Height="26" Margin="0,0,4,0" Click="Profile_Click" ToolTip="Switch bookmark profile">
                    <TextBlock x:Name="ProfileLabel" Margin="12,0" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ProfileMenu">
                            <MenuItem Header="Work" Click="Profile_Select"/>
                            <MenuItem Header="Private" Click="Profile_Select"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="⬇" Click="Downloads_Click" ToolTip="Downloads (Ctrl+J)"/>
                <Button Content="⋮" Click="Menu_Click" ToolTip="Menu">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MainMenu">
                            <MenuItem Header="History" InputGestureText="Ctrl+H" Click="History_Click"/>
                            <MenuItem Header="Developer tools" InputGestureText="F12" Click="DevTools_Click"/>
                            <MenuItem x:Name="ImportItem" Header="Import bookmarks from Edge" SubmenuOpened="Import_SubmenuOpened">
                                <MenuItem Header="…" IsEnabled="False"/>
                            </MenuItem>
                            <MenuItem Header="Use this page as home" Click="SetHome_Click"/>
                            <MenuItem Header="Clear browsing data" Click="ClearData_Click"/>
                            <Separator/>
                            <MenuItem x:Name="VersionItem" IsEnabled="False"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Bookmarks bar: one horizontal row under the toolbar; scrolls with the mouse wheel when it overflows. -->
        <Grid x:Name="BookmarkRow" Grid.Row="2" Background="{StaticResource Surface}" Height="30">
            <TextBlock x:Name="BookmarkHint" Text="Press ☆ to add bookmarks to this profile" Foreground="{StaticResource Muted}" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,2" IsHitTestVisible="False"/>
            <ScrollViewer x:Name="BookmarkScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"
                          PreviewMouseWheel="BookmarkScroll_MouseWheel">
                <ItemsControl x:Name="BookmarkBar" Margin="4,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="Auto" Height="24" Margin="2,0" FontSize="12" ToolTip="{Binding Url}"
                                    Click="Bookmark_Click" MouseRightButtonUp="Bookmark_RightClick">
                                <TextBlock Text="{Binding Label}" Margin="10,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- One WebView2 per tab; only the selected one is visible. -->
        <Grid x:Name="Host" Grid.Row="3"/>
    </Grid>
</Window>
